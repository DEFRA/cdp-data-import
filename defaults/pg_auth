# Sourced by the psql, pg_restore and pg_dump wrappers with the wrapper's arguments.
# Fills in connection defaults for a CDP service database. Values that are already set
# (as environment variables or as connection arguments) always win.

source /usr/local/lib/cdp-data-import/common

pg_needs_connection=true

pg_args=("$@")
for ((i = 0; i < ${#pg_args[@]}; i++)); do
  arg="${pg_args[$i]}"
  next="${pg_args[$((i + 1))]:-}"
  case "$arg" in
    -V | --version | -\? | --help) pg_needs_connection=false ;;
    -h | --host) PGHOST="$next" ;;
    --host=*) PGHOST="${arg#--host=}" ;;
    -p | --port) PGPORT="$next" ;;
    --port=*) PGPORT="${arg#--port=}" ;;
    -U | --username) PGUSER="$next" ;;
    --username=*) PGUSER="${arg#--username=}" ;;
    -d | --dbname) pg_dbname_arg="$next" ;;
    --dbname=*) pg_dbname_arg="${arg#--dbname=}" ;;
  esac
done

# A postgresql:// URI in --dbname carries the host and database name
if [[ "${pg_dbname_arg:-}" =~ ^postgres(ql)?://([^/:?]+)(:([0-9]+))?(/([^?]*))? ]]; then
  PGHOST="${BASH_REMATCH[2]}"
  PGPORT="${BASH_REMATCH[4]:-${PGPORT:-}}"
  [[ -n "${BASH_REMATCH[6]}" ]] && PGDATABASE="${BASH_REMATCH[6]}"
elif [[ -n "${pg_dbname_arg:-}" ]]; then
  PGDATABASE="$pg_dbname_arg"
fi

if [[ "$pg_needs_connection" == true ]]; then
  service_db_name="${SERVICE:+${SERVICE//-/_}}"

  export PGPORT="${PGPORT:-5432}"
  export PGDATABASE="${PGDATABASE:-$service_db_name}"
  export PGUSER="${PGUSER:-${PGDATABASE:+${PGDATABASE}_ddl}}"

  if [[ -z "${PGHOST:-}" && -n "${SERVICE:-}" ]]; then
    PGHOST="$(aws-rds-token -service "$SERVICE" -host)"
  fi
  export PGHOST="${PGHOST:-}"

  if [[ -z "$PGHOST" || -z "$PGUSER" || -z "$PGDATABASE" ]]; then
    log "cannot work out the database connection: set SERVICE, or PGHOST, PGUSER and PGDATABASE"
    exit 1
  fi

  if [[ -z "${PGPASSWORD:-}" ]]; then
    PGPASSWORD="$(aws rds generate-db-auth-token --hostname "$PGHOST" --port "$PGPORT" --region "$AWS_REGION" --username "$PGUSER")"
    export PGPASSWORD
  fi

  log "connecting as $PGUSER to $PGDATABASE on $PGHOST:$PGPORT (sslmode=${PGSSLMODE:-prefer})"
fi
